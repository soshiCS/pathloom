{
  "schema_version": "2.0",
  "name": "checkout_paths",
  "version": 3,
  "status": "approved",
  "description": "Log in to SauceDemo with the supplied credentials. Follow the selected routes exactly. If product_route is 'inventory', add {{product_name}} to the cart directly from the Products page. If product_route is 'details', first open the {{product_name}} product details page and add it to the cart from there. Then, if cart_route is 'cart_link', open the cart by clicking the visible shopping cart control at the top right; if cart_route is 'cart_url', navigate to https://www.saucedemo.com/cart.html. Click Checkout, fill in the first name, last name and postal code, click Continue to reach the Checkout: Overview page, extract only the displayed Total as the output named total, and stop there. Never click Finish.",
  "surface": {
    "kind": "web",
    "app": "Swag Labs",
    "entry_url": "https://www.saucedemo.com/",
    "allowed_hosts": [
      "www.saucedemo.com"
    ]
  },
  "inputs": {
    "username": {
      "type": "string",
      "required": true,
      "sensitive": false,
      "description": "Value typed where 'username' was used during discovery"
    },
    "password": {
      "type": "string",
      "required": true,
      "sensitive": true,
      "description": "Value typed where 'password' was used during discovery"
    },
    "product_name": {
      "type": "string",
      "required": true,
      "sensitive": false,
      "description": "Value typed where 'product_name' was used during discovery"
    },
    "first_name": {
      "type": "string",
      "required": true,
      "sensitive": false,
      "description": "Value typed where 'first_name' was used during discovery"
    },
    "last_name": {
      "type": "string",
      "required": true,
      "sensitive": false,
      "description": "Value typed where 'last_name' was used during discovery"
    },
    "postal_code": {
      "type": "string",
      "required": true,
      "sensitive": false,
      "description": "Value typed where 'postal_code' was used during discovery"
    },
    "product_route": {
      "type": "string",
      "required": true,
      "sensitive": false,
      "description": "Value typed where 'product_route' was used during discovery",
      "selector": true
    },
    "cart_route": {
      "type": "string",
      "required": true,
      "sensitive": false,
      "description": "Value typed where 'cart_route' was used during discovery",
      "selector": true
    }
  },
  "outputs": {
