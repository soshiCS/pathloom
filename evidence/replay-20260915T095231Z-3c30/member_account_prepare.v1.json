{
  "schema_version": "2.0",
  "name": "member_account_prepare",
  "version": 1,
  "status": "draft",
  "description": "Sign in to MemberOps with the supplied training credentials. Follow the selected lookup_method exactly: if it is 'member_id', use the member ID lookup and search by {{member_id}}; if it is 'phone', use the phone lookup and search by {{phone}}. Open the member's profile, start a new sub-account, choose exactly the selected account_type ('savings' or 'checking'), enter the supplied opening deposit, and continue to the review page. On the review page, extract the member name as member_name, the account type as account_type, and the opening deposit amount as opening_deposit, then stop. Never click 'Confirm and Open Account'; the account must not be created.",
  "surface": {
    "kind": "web",
    "app": "Sign in - MemberOps Sandbox",
    "entry_url": "http://127.0.0.1:8765/",
    "allowed_hosts": [
      "127.0.0.1"
    ]
  },
  "inputs": {
    "username": {
      "type": "string",
      "required": true,
      "sensitive": false,
      "description": "Value typed where 'username' was used during discovery"
    },
    "password": {
      "type": "string",
      "required": true,
      "sensitive": true,
      "description": "Value typed where 'password' was used during discovery"
    },
    "lookup_method": {
      "type": "string",
      "required": true,
      "sensitive": false,
      "description": "Value typed where 'lookup_method' was used during discovery",
      "selector": true
    },
    "member_id": {
      "type": "string",
      "required": false,
      "sensitive": false,
      "description": "Value typed where 'member_id' was used during discovery",
      "required_when": [
        {
          "lookup_method": "member_id",
          "account_type": "savings"
        },
        {
          "lookup_method": "member_id",
          "account_type": "checking"
        }
      ]
    },
    "account_type": {
      "type": "string",
      "required": true,
      "sensitive": false,
      "description": "Value typed where 'account_type' was used during discovery",
      "selector": true
    },
    "opening_deposit": {
      "type": "string",
      "required": true,
      "sensitive": false,
      "description": "Value typed where 'opening_deposit' was used during discovery"
    },
    "phone": {
      "type": "string",
      "required": false,
      "sensitive": false,
      "description": "Value typed where 'phone' was used during discovery",
      "required_when": [
        {
          "lookup_method": "phone",
          "account_type": "savings"
        }
      ]
    }
  },
  "outputs": {
    "member_name": {
      "type": "string",
      "required": true,
      "pattern": "Member name:\\s*(.+)",
      "description": "Text read from text ''",
      "example": "Alex Morgan"
    },
    "account_type": {
      "type": "string",
      "required": true,
      "pattern": "Account type:\\s*(\\w+)",
      "description": "Text read from text ''",
      "example": "Savings"
    },
    "opening_deposit": {
      "type": "number",
      "required": true,
      "pattern": "Opening deposit:\\s*\\$\\s*([\\d.]+)",
      "description": "Text read from text ''",
      "example": "{{opening_deposit}}.00"
    }
  },
