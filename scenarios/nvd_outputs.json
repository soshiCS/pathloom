{
  "cve_ids": {
    "type": "list",
    "required": true,
    "min_items": 3,
    "max_items": 3,
    "items": {
      "type": "string",
      "pattern": "(CVE-\\d{4}-\\d+)"
    }
  },
  "descriptions": {
    "type": "list",
    "required": true,
    "min_items": 3,
    "max_items": 3,
    "items": {
      "type": "string",
      "pattern": "^([\\s\\S]+)$"
    }
  },
  "cvss_scores": {
    "type": "list",
    "required": true,
    "min_items": 3,
    "max_items": 3,
    "items": {
      "type": "number",
      "pattern": "^(\\d+(?:\\.\\d+)?)"
    }
  },
  "published_dates": {
    "type": "list",
    "required": true,
    "min_items": 3,
    "max_items": 3,
    "items": {
      "type": "string",
      "pattern": "^([\\s\\S]+)$"
    }
  }
}
