{
  "filing_dates": {
    "type": "list",
    "required": true,
    "min_items": 3,
    "max_items": 3,
    "items": {
      "type": "string",
      "pattern": "(\\d{4}-\\d{2}-\\d{2})"
    }
  },
  "reporting_periods": {
    "type": "list",
    "required": true,
    "min_items": 3,
    "max_items": 3,
    "items": {
      "type": "string",
      "pattern": "(\\d{4}-\\d{2}-\\d{2})"
    }
  },
  "accession_numbers": {
    "type": "list",
    "required": true,
    "min_items": 3,
    "max_items": 3,
    "items": {
      "type": "string",
      "pattern": "([0-9]{10}-[0-9]{2}-[0-9]{6})"
    }
  },
  "primary_documents": {
    "type": "list",
    "required": true,
    "min_items": 3,
    "max_items": 3,
    "items": {
      "type": "string",
      "pattern": "([^\\s]+\\.htm)"
    }
  }
}
