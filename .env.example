# Only the selected provider key is needed for `discover`. Replay uses neither.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Optional provider-specific discovery model overrides.
ANTHROPIC_MODEL=claude-opus-5
OPENAI_MODEL=gpt-6-astra

# The demo target is the public SauceDemo test site. Its published test credentials are
# passed on the command line (--param) and the password is marked --sensitive so it never
# reaches the model, the artifact, the logs, or the screenshots. Nothing is read from .env.
#   username=standard_user   password=secret_sauce
